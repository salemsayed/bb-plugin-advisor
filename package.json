  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salemsayed/bb-plugin-advisor.git"
  },
  "bugs": {
    "url": "https://github.com/salemsayed/bb-plugin-advisor/issues"
  },
  "homepage": "https://github.com/salemsayed/bb-plugin-advisor#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "app.tsx",
    "server.ts",
    "src/review.ts",
    "scripts/build.mjs",
    "dist/app.css",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/server.js",
    "dist/server.meta.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Advisor",
    "description": "A persistent second-model reviewer for bb coding threads.",
    "branding": {
      "icon": "ShieldCheck"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "bb-plugin",
    "advisor",
    "review"
  ],
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
